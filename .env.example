# Trace2Quality (t2q) Development Environment
# Copy to .env for local development

# === Application ===
APP_ENV=development
APP_DEBUG=true
APP_WORKERS=4
APP_PORT=8000

# === Security ===
APP_ENCRYPTION_KEY=dev-encryption-key-change-in-production
APP_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# === Database ===
DATABASE_URL=sqlite:///./data/trace2quality.db
# For PostgreSQL: postgresql://user:password@localhost:5432/trace2quality

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Celery ===
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# === Azure DevOps ===
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/yourorg
AZURE_DEVOPS_PROJECT=YourProject
AZURE_DEVOPS_PAT=

# === Confluence ===
CONFLUENCE_BASE_URL=https://yourdomain.atlassian.net/wiki
CONFLUENCE_SPACE=YOURSPACE
CONFLUENCE_EMAIL=your.email@domain.com
CONFLUENCE_API_TOKEN=

# === Jira ===
JIRA_BASE_URL=https://yourdomain.atlassian.net
JIRA_EMAIL=your.email@domain.com
JIRA_API_TOKEN=

# === Gemini ===
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json

# === Storage ===
ARTIFACT_STORAGE_PATH=./data/artifacts
CACHE_STORAGE_PATH=./data/cache

# === Features ===
FEATURE_DATA_MIGRATION=true
FEATURE_WEBHOOK_SYNC=false
